# ─── Convex ─────────────────────────────────────────────────────────
# Generated by `npx convex dev`. Keep in sync with your deployment.
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_SITE_URL=

# ─── Clerk (required for auth) ──────────────────────────────────────
# From https://dashboard.clerk.com → your app → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Where auth.protect() redirects signed-out visitors (route exists in the app)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in

# Also set these on the Convex deployment (NOT .env.local):
#   npx convex env set CLERK_JWT_ISSUER https://<your-app>.clerk.accounts.dev
#   npx convex env set ALLOWED_USER_IDS user_abc123,user_def456
# CLERK_JWT_ISSUER is referenced by convex/auth.config.ts to validate JWTs;
# ALLOWED_USER_IDS is the single-user allowlist enforced by requireUser() in
# convex/lib/auth.ts (handlers fail closed if it's unset).

# ─── Sentry (optional) ──────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
